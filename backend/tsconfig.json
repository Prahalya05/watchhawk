{
  // Editor + `npm run typecheck` config: covers everything that is real TypeScript in
  // this package, including tests, the Prisma seed and the one-off scripts. Emit settings
  // live here only so tsconfig.build.json can inherit them; nothing is emitted from this
  // config (typecheck runs it with --noEmit).
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src", "tests", "scripts", "prisma"]
}
