# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://watchlist:watchlist@localhost:5432/watchlist"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth. Rejected at boot below 32 characters — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Admin demo-trigger endpoint (X-Admin-Key header). Minimum 16 characters.
ADMIN_KEY="change-me-admin-key-please"

# Market data
# MARKET_DATA_MODE: "live" (Twelve Data + Yahoo fallback) or "replay" (fully synthetic, no
# external calls at all). Leave TWELVE_DATA_API_KEY unset (or set MARKET_DATA_MODE=replay)
# to run the whole app with zero external dependencies.
MARKET_DATA_MODE="live"
TWELVE_DATA_API_KEY=""

# Poll interval for the primary market data provider, in ms. See
# docs/scope-and-limitations.md for the rate-limiting notes behind this default.
MARKET_POLL_INTERVAL_MS="45000"

# A symbol whose market:state hasn't updated within this many ms is marked isStale.
# Lower it for a fast live staleness demo (e.g. via FREEZE).
STALE_THRESHOLD_MS="120000"

# HTTP port
PORT="4000"

# --- Assistant (Gemini) -------------------------------------------------------
# Entirely optional. Without a key the assistant still works: commands fall back to the
# built-in pattern parser (backend/src/domain/assistant/command.rules.ts) and event
# explanations fall back to their deterministic summaries. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_MS="8000"

# Self-imposed spend ceilings, not Google's published limits — Google no longer publishes
# free-tier quotas in the docs and points you at AI Studio instead. Check the limits shown
# for your own key at https://aistudio.google.com/rate-limit and set these at or below them.
# Hitting a ceiling degrades the assistant to its deterministic path; it never errors.
GEMINI_MAX_REQUESTS_PER_MINUTE="8"
GEMINI_MAX_REQUESTS_PER_DAY="200"

# --- Event feeds (news / corporate actions) ----------------------------------
# Real NEWS and CORPORATE_ACTION ingestion. Neither feed needs an API key: headlines come
# from Google News' region-scoped RSS search and dividends/splits from the same Yahoo chart
# endpoint the price provider uses. Analyst RATING_CHANGE has no free source that covers
# NSE (see docs/scope-and-limitations.md), so those remain admin-panel demo triggers.
#
#   auto  follow MARKET_DATA_MODE — on in live, off in replay. Real headlines beside
#         synthetic prices is a confusing demo, and polling two vendors for symbols nobody
#         is watching live is spend with no reader.
#   on    force it on, including replay mode, to exercise the feed path without a market.
#   off   disable it entirely; the admin panel still triggers all three event types.
EVENT_FEED_ENABLED="auto"
EVENT_FEED_INTERVAL_MS="900000"
