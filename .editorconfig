# Editor-level defaults so formatting is consistent before Prettier ever runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown gives meaning to trailing double-spaces (a hard line break).
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
